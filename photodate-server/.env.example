PORT=3001
HOST=0.0.0.0
CLIENT_ORIGINS=http://localhost:5173
# DB_PATH=C:/data/photodate.db
RETENTION_HOURS=24
RECONNECT_GRACE_MS=120000
# Also bounds new room reservations before their first authenticated socket join.

# Enable only behind a reverse proxy on this machine (see deploy/nginx.conf.example).
# TRUST_PROXY=loopback
# Requests above this concurrency receive 503 + Retry-After before JSON parsing.
MAX_IN_FLIGHT_REQUESTS=32
